# Required for live provider-backed routes. Fixture tests do not need these values.
# Brave Search credential for public-source discovery.
BRAVE_SEARCH_API_KEY=
# OpenRouter credential for research and structured brief compilation.
OPENROUTER_API_KEY=
# OpenRouter model route that supports tool calling and strict JSON-schema output.
RESEARCH_MODEL=
# Service account JSON for appending approved briefs to the configured spreadsheet.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Identifier of the single Google Sheets demonstration spreadsheet.
GOOGLE_SHEET_ID=
# Neon or local Postgres connection URL for session-owned application records.
DATABASE_URL=
# Upstash Redis or Vercel KV REST endpoint for shared limits and active-run counters.
KV_REST_API_URL=
# Credential for the configured KV REST endpoint.
KV_REST_API_TOKEN=
# At least 32 random characters used to sign anonymous session and owner-capability cookies.
SESSION_SIGNING_SECRET=
# Presenter-only code required before a same-session approved pack may export.
DEMO_EXPORT_CODE=
# Secret Vercel Cron sends to authenticate the daily expired-session cleanup request.
CRON_SECRET=
